# Supabase (same values as savemonei-mobile .env)
# Copy from app or use SUPABASE_* names below
SUPABASE_URL=https://oigsjbbmxebegjbwnbid.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9pZ3NqYmJteGViZWdqYnduYmlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjU2ODc2NzYsImV4cCI6MjA4MTI2MzY3Nn0.pUTXPdfB52uMq9Ec2iWFtMRDSeQXHM5d7marejLDJ3Q


# Or backend-only names (optional)
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Required for profile API (GET/PUT /profile). From Supabase: Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server
PORT=4000
NODE_ENV=development

# AI — legacy OpenAI intents (POST /ai/ask) — optional
OPENAI_API_KEY=

# OpenRouter — assistant Planner / Reasoner proxy (server-only; never put in mobile EXPO_PUBLIC_*)
OPENROUTER_API_KEY=
# Ordered free-only chains (primary first). Comma-separated. Falls through on failure.
OPENROUTER_PLANNER_MODELS=openrouter/free,openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_REASONER_MODELS=openrouter/free,openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free
# Optional legacy single + shared fallbacks (merged into chains above)
# OPENROUTER_PLANNER_MODEL=openrouter/free
# OPENROUTER_REASONER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_RETRIES=1
OPENROUTER_RATE_LIMIT_PER_MIN=20
OPENROUTER_HTTP_REFERER=https://savemonei.app
OPENROUTER_APP_TITLE=SaveMonei
